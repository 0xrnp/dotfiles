# ==============================================================================
#  GHOSTTY CONFIG
#  Reload: cmd+shift+,     Docs: ghostty +show-config --default --docs
# ==============================================================================

# ==============================================================================
# CORE
# ==============================================================================

shell-integration = zsh
# no-cursor keeps your block cursor (integration would otherwise force a bar
# at the prompt). ssh-* make remote hosts understand xterm-ghostty.
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

auto-update = download
auto-update-channel = stable

# Reading the clipboard silently lets any program (incl. over SSH) grab it.
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard

confirm-close-surface = true
quit-after-last-window-closed = true
window-save-state = always

# ==============================================================================
# FONT
# ==============================================================================

font-family = "Maple Mono NF"
# Regular weight + no thickening = the thin, crisp Alacritty look.
# (SemiBold + font-thicken was what made it feel heavy and blobby.)
font-size = 13

# Ligatures on (=> != >= render as joined glyphs). Remove both lines to disable.
font-feature = calt
font-feature = liga

font-thicken = false

adjust-cell-height = 18%
adjust-underline-position = 2

window-title-font-family = "Maple Mono NF"

# ==============================================================================
# THEME / COLOR
# ==============================================================================

theme = Catppuccin Mocha
window-theme = dark

# Slightly deeper than Mocha's base so the frosted glass reads darker,
# like the Alacritty window. Text stays Catppuccin.
background = #181825
foreground = #cdd6f4

window-colorspace = display-p3
alpha-blending = native
minimum-contrast = 1.1
bold-is-bright = false

# The frosted, wallpaper-smeared glass. Lower opacity = more wallpaper.
background-opacity = 1
background-opacity-cells = true
background-blur = 40

unfocused-split-opacity = 0.80
split-divider-color = #45475a

# ==============================================================================
# CURSOR / MOUSE
# ==============================================================================

cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.9
cursor-click-to-move = true

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
link-url = true

# ==============================================================================
# WINDOW
# ==============================================================================

window-decoration = auto
window-subtitle = working-directory
window-inherit-working-directory = true
window-inherit-font-size = true

window-padding-x = 18
window-padding-y = 14
window-padding-balance = true
window-padding-color = extend

# No window-width/height: AeroSpace owns window size and position.

macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-window-shadow = true
# Left option = Alt (for shell/vim), right option still types ©, €, etc.
macos-option-as-alt = left
# Native fullscreen creates a new macOS Space, which AeroSpace can't manage.
# Non-native stays inside your AeroSpace workspace. (Prefer AeroSpace's own
# `fullscreen` command anyway.)
macos-non-native-fullscreen = visible-menu

# ==============================================================================
# QUICK TERMINAL (drop-down, Quake-style)
# ==============================================================================

quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-size = 45%
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true
quick-terminal-space-behavior = move

# ==============================================================================
# PERFORMANCE
# ==============================================================================

resize-overlay = never
# Bytes per surface. 100 MB is effectively endless history.
scrollback-limit = 100000000

# ==============================================================================
# KEYBINDS
# ==============================================================================

# Quick terminal from anywhere in macOS (grant Accessibility permission once)
keybind = global:super+grave_accent=toggle_quick_terminal

# --- AeroSpace-friendly ---
# macOS native tabs show up as separate windows to AeroSpace and wreck the
# layout. Cmd+T opens a real window instead, which AeroSpace tiles cleanly.
# Use splits (below) for panes inside one window.
keybind = super+t=new_window

# --- Splits ---
# All binds use Cmd (super). AeroSpace's defaults use Alt alone, so no overlap.
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+shift+enter=toggle_split_zoom
keybind = super+shift+e=equalize_splits

keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down

keybind = super+ctrl+left=resize_split:left,20
keybind = super+ctrl+right=resize_split:right,20
keybind = super+ctrl+up=resize_split:up,20
keybind = super+ctrl+down=resize_split:down,20

# --- Navigation ---
keybind = super+shift+up=jump_to_prompt:-1
keybind = super+shift+down=jump_to_prompt:1
keybind = super+shift+a=select_all
keybind = super+k=clear_screen

# --- Font size ---
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

# --- Misc ---
keybind = super+shift+p=toggle_command_palette
keybind = super+shift+comma=reload_config
# Newline without submitting (Claude Code, AI CLIs, multi-line prompts)
keybind = shift+enter=text:\x1b\r