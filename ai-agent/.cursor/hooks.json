{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/inject-standards.sh",
        "timeout": 5
      },
      {
        "command": "./hooks/verify-turn.sh start",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "bash ./hooks/strip-cursor-attribution.sh",
        "failClosed": true,
        "timeout": 5,
        "matcher": "Shell"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./hooks/gate-shell.sh",
        "failClosed": true,
        "timeout": 5
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "./hooks/gate-mcp.sh",
        "failClosed": true,
        "timeout": 5
      }
    ],
    "beforeReadFile": [
      {
        "command": "./hooks/gate-read.sh",
        "failClosed": true,
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "./hooks/verify-turn.sh stop",
        "timeout": 480,
        "loop_limit": 1
      }
    ]
  }
}
