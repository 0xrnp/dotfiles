{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/inject-standards.sh",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/gate-plan-approve.sh",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "./hooks/gate-edit.sh",
        "failClosed": true,
        "timeout": 5,
        "matcher": "Write|StrReplace|Delete|EditNotebook|Edit|ApplyPatch|DeleteFile|SearchReplace"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./hooks/gate-shell.sh",
        "failClosed": true,
        "timeout": 5
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "./hooks/gate-mcp.sh",
        "failClosed": true,
        "timeout": 5
      }
    ],
    "beforeReadFile": [
      {
        "command": "./hooks/gate-read.sh",
        "failClosed": true,
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "python3 \"$HOME/ai-standards/approval-gate.py\" cursor lock",
        "timeout": 5
      }
    ]
  }
}
